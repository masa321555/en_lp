{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "en-lp",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // Secrets（ダッシュボードまたは `npx wrangler secret put <NAME>` で設定。コードや設定ファイルに書かない）:
  //   RESEND_API_KEY   … Resend のAPIキー
  //   TURNSTILE_SECRET … Turnstile のシークレットキー（未設定なら検証をスキップ）
  // Vars（公開して問題ない値）:
  // "vars": { "CONTACT_TO": "info@example.com", "CONTACT_FROM": "LP <noreply@example.com>" }
}
